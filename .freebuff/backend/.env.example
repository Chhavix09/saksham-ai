# Scheme Up backend configuration
# Copy to `.env` and fill in real values. NEVER commit the real .env file.

# development | production
ENVIRONMENT=development

# SQLite by default (zero setup). For production use PostgreSQL, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/schemeup
DATABASE_URL=sqlite:///./sakshamai.db

# JWT secrets — MUST be changed in production (generate with: openssl rand -hex 32)
JWT_SECRET=dev-only-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REMEMBER_ME_EXPIRE_MINUTES=43200

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Simple in-memory rate limiting for auth endpoints
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Optional ML ranking layer (needs scikit-learn)
ENABLE_ML=true

# ---------------------------------------------------------------- AI Assistant
# Provider: openai | anthropic | gemini | none
# The assistant works without a key (deterministic, database-backed answers).
# Set a provider + key to enable real LLM replies. Keys stay on the server.
AI_PROVIDER=none
# AI_API_KEY=sk-...
# For Gemini you may use either name (AI_API_KEY takes precedence):
# GEMINI_API_KEY=your-gemini-key
# Optional model override; sensible defaults are used when empty:
#   openai    -> gpt-4o-mini
#   anthropic -> claude-3-5-haiku-latest
#   gemini    -> gemini-3.6-flash
# AI_MODEL=
# Optional for OpenAI-compatible APIs (Groq, OpenRouter, Azure, local LLMs):
#   AI_PROVIDER=openai
#   AI_BASE_URL=https://api.groq.com/openai/v1
# AI_BASE_URL=
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=700
AI_REQUEST_LIMIT_PER_MINUTE=12
